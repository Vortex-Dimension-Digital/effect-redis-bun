{
  "name": "@vortexdd/effect-redis-bun",
  "version": "3.1.0",
  "description": "Effect Redis service and KeyValueStore integration using Bun's native Redis client",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/index.ts",
    "EXAMPLES.md"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun --format esm --minify --sourcemap=external --packages=external && tsrs -p tsconfig.build.json",
    "check": "bun fmt --check && bun run lint && bun run typecheck",
    "format": "bun fmt",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsrs",
    "test": "bun test",
    "test:integration": "bun test src/index.integration.test.ts",
    "prepublishOnly": "bun run check && bun test && bun run build"
  },
  "keywords": [
    "effect",
    "bun",
    "redis",
    "keyvaluestore",
    "effect-ts",
    "valkey"
  ],
  "author": "vortexdd",
  "license": "MIT",
  "repository": "github:Vortex-Dimension-Digital/effect-redis-bun",
  "bugs": {
    "url": "https://github.com/Vortex-Dimension-Digital/effect-redis-bun/issues"
  },
  "homepage": "https://github.com/Vortex-Dimension-Digital/effect-redis-bun#readme",
  "peerDependencies": {
    "@effect/platform": ">=0.52.3 <1",
    "effect": ">=3.1.2 <4"
  },
  "devDependencies": {
    "@effect/platform": "0.97.3",
    "@types/bun": "1.4.4",
    "effect": "3.22.4",
    "oxlint": "1.90.0",
    "tsrs": "0.20.1-ts7.1.0-beta"
  },
  "engines": {
    "bun": ">=1.2.22"
  }
}
